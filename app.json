{
  "expo": {
    "name": "Pastis and Points",
    "slug": "pastis-and-points",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pastis.and.points",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pastis.and.points",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "display": "standalone",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "lang": "fr-FR",
      "description": "Le compagnon de vos mènes à la pétanque",
      "name": "Pastis and Points",
      "shortName": "PastisPoints",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "extra": {
      "eas": {
        "projectId": "2d05c505-a836-46ac-9542-3a6cfd013599"
      }
    }
  }
}
